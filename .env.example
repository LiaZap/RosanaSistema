# ============================================================
# FCE — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# For EasyPanel: set these in each service's Environment tab.
# ============================================================

# ── Node ─────────────────────────────────────────────
NODE_ENV=development

# ── Postgres ─────────────────────────────────────────
# Local dev: localhost:5432
# EasyPanel: use the internal service name (e.g. postgres-fce)
POSTGRES_DB=fce
POSTGRES_USER=fce
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://fce:changeme@localhost:5432/fce

# ── Redis ────────────────────────────────────────────
# Local dev: localhost
# EasyPanel: use the internal service name (e.g. redis-fce)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MinIO (S3 storage) ──────────────────────────────
# Local dev: http://localhost:9000
# EasyPanel: http://minio-fce:9000 (internal network)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fce-media

# ── Backend API ─────────────────────────────────────
API_PORT=3001
LOG_LEVEL=info
# Public URL of the backend (used to build OAuth callback URLs).
# Local dev: http://localhost:3001
# EasyPanel: https://liamed-fce-api.leyiy3.easypanel.host
API_URL=http://localhost:3001

# ── Frontend ────────────────────────────────────────
# Vite build-time variable. Use /api for production (nginx proxy).
VITE_API_URL=http://localhost:3001

# ── CORS & Cookies ──────────────────────────────────
# Local dev: http://localhost:3000
# EasyPanel: https://fce.seudominio.com.br
FRONTEND_URL=http://localhost:3000
# Leave empty for local dev. In production: .fce.seudominio.com.br
COOKIE_DOMAIN=

# ── AI (Google Gemini — DANI) ───────────────────────
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-your-key-here

# ── AI (Anthropic Claude — opcional) ────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── WhatsApp (Evolution API) — Phase 2+ ─────────────
# EVOLUTION_API_URL=https://your-evolution-instance.com
# EVOLUTION_API_KEY=your-key

# ── Bling ERP — Phase 2+ ────────────────────────────
# Configured via UI (Settings > Bling)

# ── Cloudinary — Phase 2+ ───────────────────────────
# Configured via UI (Settings > Bling > Cloudinary)
