# ============================================================
# FCE - Production Environment Variables
# ============================================================
# Copy this to .env and replace ALL {{CHANGE_ME}} placeholders.
# Run: scripts/generate-secrets.sh to auto-generate passwords.
# ============================================================

# ── Domain & URLs ────────────────────────────────────────
NODE_ENV=production
# Replace with your actual domain:
FRONTEND_URL=https://fce.seudominio.com.br
VITE_API_URL=/api

# ── Postgres ─────────────────────────────────────────────
POSTGRES_DB=fce
POSTGRES_USER=fce
POSTGRES_PASSWORD={{CHANGE_ME_POSTGRES_PASSWORD}}
DATABASE_URL=postgresql://fce:{{CHANGE_ME_POSTGRES_PASSWORD}}@postgres:5432/fce

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MinIO (S3-compatible storage) ────────────────────────
MINIO_ROOT_USER=fceadmin
MINIO_ROOT_PASSWORD={{CHANGE_ME_MINIO_PASSWORD}}
# Internal Docker address (containers talk to minio on port 9000):
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=fce-media

# ── Backend (Hono) ──────────────────────────────────────
API_PORT=3001
LOG_LEVEL=info
# Must match your FRONTEND_URL domain with a leading dot:
COOKIE_DOMAIN=.fce.seudominio.com.br

# ── AI (Anthropic Claude) ───────────────────────────────
ANTHROPIC_API_KEY={{CHANGE_ME_ANTHROPIC_KEY}}

# ── WhatsApp (Evolution API) ────────────────────────────
# These are configured via UI (Settings > WhatsApp), but can
# also be pre-seeded here if you prefer:
# EVOLUTION_API_URL=https://your-evolution-instance.com
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE_NAME=agentedani

# ── Bling ERP (OAuth2) ─────────────────────────────────
# Configured via UI (Settings > Bling). OAuth tokens stored in DB.
# BLING_CLIENT_ID=your-bling-client-id
# BLING_CLIENT_SECRET=your-bling-client-secret

# ── Cloudinary (Image hosting) ──────────────────────────
# Configured via UI (Settings > Bling > Cloudinary section).
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
